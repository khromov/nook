# Environment variables for local development

# Set to 'true' to disable OPFS support for testing purposes
# This allows testing the fallback behavior without OPFS
# Useful for testing on browsers that don't support OPFS or for development
PUBLIC_DISABLE_OPFS=false

# Override the base URL for model files. Leave empty to serve models from the
# same origin (self-hosted Docker). When empty, set LOCAL_MODELS_PATH on the
# server and download models first: node scripts/download-models.js
PUBLIC_BASE_MODEL_URL=